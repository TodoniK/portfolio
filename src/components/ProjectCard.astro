---
import ProjectThumb from "./ProjectThumb.astro";
import { href, type Locale, type Project } from "../data/site";
interface Props { project: Project; locale: Locale; headingLevel?: "h2" | "h3"; eager?: boolean }
const { project: p, locale, headingLevel = "h3", eager = false } = Astro.props;
const H = headingLevel;
---
<article class="card pcard" data-spotlight data-clusters={p.clusters.join(" ")}>
  <div class="media"><ProjectThumb id={p.id} cluster={p.clusters[0]} eager={eager} /></div>
  <div class="text">
    <p class="meta">{p.tag} · {p.article.timeline[locale]}{p.confidential && <span> · {locale === "fr" ? "Confidentiel" : "Confidential"}</span>}</p>
    <H class="name"><a href={href(locale, `/projects/${p.id}`)}>{p.title}</a></H>
    <p class="desc">{p.description}</p>
  </div>
</article>
<style>
  .pcard { display: flex; flex-direction: column; height: 100%; }
  .media { padding: 0.5rem 0.5rem 0; }
  .text { padding: 1rem 1.25rem 1.35rem; display: grid; gap: 0.35rem; align-content: start; }
  .meta { font-size: var(--t-xs); font-weight: 500; color: var(--fg-2); }
  .name { font-size: var(--t-lg); font-weight: 600; letter-spacing: -0.022em; line-height: 1.25; }
  .name a::after { content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; }
  .name a:focus-visible { outline: none; }
  .pcard:has(.name a:focus-visible) { outline: 2px solid var(--link); outline-offset: 3px; }
  .desc { color: var(--fg-2); font-size: var(--t-sm); line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
</style>
