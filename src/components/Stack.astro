---
// Port of React Bits "LogoLoop": monochrome logos, hover pauses and reveals colour.
import { UI, type Locale } from "../data/site";
import { brand, type Brand } from "../data/brands";
interface Props { locale: Locale }
const ui = UI[Astro.props.locale];
const ids: Brand[] = [
  "docker", "kubernetes", "azure", "aws", "oracle", "cloudflare", "dokploy", "traefikproxy", "terraform", "linux",
  "gitlab", "github", "hermes", "opencode", "claude", "java", "springboot", "kotlin", "typescript", "react",
  "svelte", "nodedotjs", "rust", "python", "postgresql", "mongodb", "redis", "astro",
];
const list = ids.map(brand);
---
<section class="stack" aria-labelledby="stack-title">
  <div class="wrap"><h2 id="stack-title" class="eyebrow">{ui.stackTitle}</h2></div>
  <div class="viewport">
    {[0, 1].map((copy) => (
      <ul class="row" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
        {list.map((i) => <li><span class:list={["ic", { dark: i.dark }]}><img src={i.src} alt="" width="20" height="20" loading="lazy" decoding="async" /></span><span>{i.name}</span></li>)}
      </ul>
    ))}
  </div>
</section>
<style>
  .stack { padding-block: clamp(2.5rem, 6vw, 4rem); overflow: hidden; border-block: 1px solid var(--line); }
  .stack .eyebrow { margin-bottom: 1.5rem; }
  .viewport { display: flex; width: max-content; animation: marquee 70s linear infinite; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .stack:hover .viewport { animation-play-state: paused; }
  .row { display: flex; gap: 2.25rem; padding-right: 2.25rem; }
  .row li { display: inline-flex; align-items: center; gap: 0.6rem; white-space: nowrap; font-size: var(--t-sm); font-weight: 500; color: var(--fg-2); transition: color 0.3s; }
  .ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: #f2f2f5; opacity: 0.55; filter: grayscale(1); transition: filter 0.4s, opacity 0.4s, transform 0.4s var(--spring); }
  .ic.dark { background: #232327; }
  .ic img { width: 20px; height: 20px; object-fit: contain; }
  .row li:hover { color: var(--fg); }
  .row li:hover .ic { filter: none; opacity: 1; transform: scale(1.1); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .viewport { width: auto; animation: none; mask-image: none; }
    .row { flex-wrap: wrap; padding-inline: var(--gutter); gap: 1rem 2rem; }
    .row[aria-hidden="true"] { display: none; }
  }
</style>
