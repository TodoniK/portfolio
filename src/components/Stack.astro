---
import { UI, type Locale } from "../data/site";
interface Props { locale: Locale }
const ui = UI[Astro.props.locale];
const icons = import.meta.glob<string>("../assets/brands/*.svg", { eager: true, query: "?url", import: "default" });
const items: Array<[string, string]> = [
  ["Docker", "docker"], ["Kubernetes", "kubernetes"], ["Azure", "azure"], ["AWS", "aws"], ["Oracle Cloud", "oracle"],
  ["Cloudflare", "cloudflare"], ["Dokploy", "dokploy"], ["Traefik", "traefikproxy"], ["Terraform", "terraform"], ["Linux", "linux"],
  ["GitLab CI", "gitlab"], ["GitHub", "github"], ["Hermes Agent", "hermes"], ["OpenCode", "opencode"], ["Claude", "claude"],
  ["Java", "java"], ["Spring Boot", "springboot"], ["Kotlin", "kotlin"], ["TypeScript", "typescript"], ["React", "react"],
  ["Svelte", "svelte"], ["Node.js", "nodedotjs"], ["Rust", "rust"], ["Python", "python"], ["PostgreSQL", "postgresql"], ["MongoDB", "mongodb"], ["Redis", "redis"],
];
const list = items.map(([name, file]) => ({ name, src: icons[`../assets/brands/${file}.svg`] }));
---
<section class="stack on-ink" aria-labelledby="stack-title">
  <h2 id="stack-title" class="visually-hidden">{ui.stackTitle}</h2>
  <p class="mono label" aria-hidden="true">{ui.stackTitle}</p>
  <div class="viewport">
    {[0, 1].map((copy) => (
      <ul class="row" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
        {list.map((i) => (
          <li class="mono">{i.src && <img src={i.src} alt="" width="22" height="22" loading="lazy" decoding="async" />}{i.name}</li>
        ))}
      </ul>
    ))}
  </div>
</section>
<style>
  .stack { padding-block: 2.5rem; border-block: 1px solid var(--line); overflow: hidden; }
  .label { padding-inline: var(--gutter); color: var(--fg-muted); margin-bottom: 1.5rem; }
  .viewport { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .stack:hover .viewport { animation-play-state: paused; }
  .row { display: flex; gap: 2.75rem; padding-right: 2.75rem; }
  .row li { display: inline-flex; align-items: center; gap: 0.75rem; white-space: nowrap; font-size: 0.875rem; }
  .row img { width: 22px; height: 22px; filter: grayscale(1) brightness(1.8) contrast(0.9); opacity: 0.85; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .viewport { width: auto; animation: none; }
    .row { flex-wrap: wrap; padding-inline: var(--gutter); gap: 1rem 2rem; }
    .row[aria-hidden="true"] { display: none; }
  }
</style>
