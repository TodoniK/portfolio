---
// Port of React Bits "ScrollVelocity": two rows drift in opposite directions and speed up with scroll velocity.
interface Props { words: string[] }
const { words } = Astro.props;
const line = words.join("  ·  ") + "  ·  ";
---
<div class="velocity" aria-hidden="true">
  {[1, -1].map((dir) => (
    <div class="row" data-velocity={dir}>
      <div class="track">{[0, 1, 2, 3].map(() => <span>{line}</span>)}</div>
    </div>
  ))}
</div>
<style>
  .velocity { overflow: hidden; padding-block: clamp(2rem, 6vw, 4rem); display: grid; gap: 0.25rem; }
  .track { display: flex; width: max-content; white-space: pre; font-size: clamp(2.6rem, 1rem + 7vw, 7rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1.05; color: var(--gray-4); will-change: transform; }
  .row:nth-child(2) .track { color: var(--fg); transform: translateX(-25%); }
  .row:first-child .track { animation: drift 40s linear infinite; }
  .row:nth-child(2) .track { animation: drift-r 40s linear infinite; }
  :global(.js-velocity) .track { animation: none; }
  @keyframes drift { to { transform: translateX(-25%); } }
  @keyframes drift-r { from { transform: translateX(-25%); } to { transform: translateX(0); } }
</style>
