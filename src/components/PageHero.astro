---
import { UI, href, pick, type Locale } from "../data/site";
interface Props { locale: Locale; kicker: string; title: string; lead?: string; crumbs?: Array<[string, string]> }
const { locale, kicker, title, lead, crumbs = [] } = Astro.props;
const ui = UI[locale];
const words = title.split(" ");
---
<section class="ph">
  <div class="halo" aria-hidden="true"></div>
  <div class="wrap inner">
    {crumbs.length > 0 && (
      <nav class="crumbs small" aria-label={pick({ fr: "Fil d'Ariane", en: "Breadcrumb", es: "Ruta de navegación" }, locale)}>
        <ol role="list">
          <li><a href={href(locale, "/")}>{ui.nav.home}</a></li>
          {crumbs.map(([label, path], i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{label}</span> : <a href={path}>{label}</a>}</li>)}
        </ol>
      </nav>
    )}
    <p class="eyebrow">{kicker}</p>
    <h1 class="ph-title"><span class="visually-hidden">{title}</span><span class="blur-in" aria-hidden="true">{words.map((w) => <><span>{w}</span>{" "}</>)}</span></h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; overflow: hidden; isolation: isolate; }
  .halo { position: absolute; inset: -40% 0 auto; height: 90%; z-index: -1; opacity: 0.5; filter: blur(50px);
    background: radial-gradient(30% 50% at 20% 50%, rgb(0 144 247 / 0.35), transparent 70%), radial-gradient(30% 50% at 70% 40%, rgb(186 98 252 / 0.3), transparent 70%); }
  .inner { padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem)); padding-bottom: clamp(2rem, 5vw, 3.5rem); display: grid; gap: 1rem; position: relative; justify-items: start; }
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; color: var(--fg-2); line-height: 1.4; }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .crumbs li + li::before { content: "/"; color: var(--fg-3); }
  .crumbs a, .crumbs [aria-current] { display: inline-flex; align-items: center; min-height: 2rem; }
  .crumbs a:hover { color: var(--fg); }
  .crumbs [aria-current] { color: var(--fg); }
  .ph-title { font-size: var(--t-3xl); font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; max-width: 18em; }
  .lead { font-size: var(--t-lg); }
</style>
