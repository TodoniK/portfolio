---
import { UI, href, type Locale } from "../data/site";
interface Props { locale: Locale; kicker: string; title: string; lead?: string; crumbs?: Array<[string, string]>; dark?: boolean }
const { locale, kicker, title, lead, crumbs = [], dark = false } = Astro.props;
const ui = UI[locale];
const words = title.split(" ");
---
<section class:list={["ph", { dark }]}>
  <slot name="media" />
  <div class="wrap inner">
    {crumbs.length > 0 && (
      <nav class="crumbs small" aria-label={locale === "fr" ? "Fil d'Ariane" : "Breadcrumb"}>
        <ol role="list">
          <li><a href={href(locale, "/")}>{ui.nav.home}</a></li>
          {crumbs.map(([label, path], i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{label}</span> : <a href={path}>{label}</a>}</li>)}
        </ol>
      </nav>
    )}
    <p class="eyebrow accent">{kicker}</p>
    <h1 class="ph-title"><span class="visually-hidden">{title}</span><span class="blur-in" aria-hidden="true">{words.map((w) => <><span>{w}</span>{" "}</>)}</span></h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; overflow: hidden; isolation: isolate; }
  .inner { padding-top: calc(var(--header-h) + clamp(3rem, 9vw, 6.5rem)); padding-bottom: clamp(2.5rem, 7vw, 5rem); display: grid; gap: 1.1rem; position: relative; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--fg-2); }
  .crumbs li + li::before { content: "›"; margin-right: 0.4rem; color: var(--fg-3); }
  .crumbs a { display: inline-block; padding-block: 0.6rem; }
  .crumbs a:hover { color: var(--fg); }
  .ph-title { font-size: var(--t-3xl); font-weight: 700; letter-spacing: -0.045em; line-height: 1.02; max-width: 16em; }
  .lead { font-size: var(--t-lg); }
</style>
