---
import { SITE, UI, type Locale } from "../data/site";
interface Props { locale: Locale }
const ui = UI[Astro.props.locale];
---

<button class="btn btn--ghost copy" type="button" data-copy={SITE.email} data-copied={ui.copied} hidden>
  <span data-copy-label>{ui.copy}</span>
</button>
<span class="visually-hidden" aria-live="polite" data-copy-status></span>
