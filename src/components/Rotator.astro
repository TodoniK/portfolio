---
// Port of React Bits "RotatingText": words cycle with a per-character spring (scripts/app.ts).
interface Props { words: string[]; class?: string }
const { words, class: cls } = Astro.props;
const first = words[0] ?? "";
---
<span class:list={["rotator-wrap", cls]}>
  <span class="visually-hidden">{words.join(" ")}</span>
  <span class="rotator" aria-hidden="true" data-rotator={JSON.stringify(words)}>{[...first].map((c) => <span class="ch">{c}</span>)}</span>
</span>
