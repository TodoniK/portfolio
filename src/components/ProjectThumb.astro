---
// Standardised project thumbnail rendered in code: short name + official logos of the stack.
// Replaces raster tiles; scripts/media/og.mjs captures the same template for Open Graph images.
import { visual } from "../data/brands";
interface Props { id: string; cluster?: string | undefined; eager?: boolean; class?: string }
const { id, cluster = "systemes-ia", eager = false, class: cls } = Astro.props;
const v = visual(id);
---
<div class:list={["thumb", `c-${cluster}`, cls]} data-thumb={id}>
  <span class="dots" aria-hidden="true"></span>
  <p class="t-name" aria-hidden="true">{v.short}</p>
  <ul class="logos" role="list">
    {v.brands.map((b) => <li class:list={{ dark: b.dark }}><img src={b.src} alt={b.name} width="32" height="32" loading={eager ? "eager" : "lazy"} decoding="async" /></li>)}
  </ul>
</div>
<style>
  .thumb {
    --tint: 186 98 252;
    position: relative; isolation: isolate; overflow: hidden; container-type: inline-size;
    aspect-ratio: 16 / 10; border-radius: var(--r); background: #111113;
    display: grid; place-content: center; justify-items: center; gap: clamp(0.75rem, 5cqi, 1.5rem);
  }
  .c-cloud-devops { --tint: 0 144 247; }
  .c-developpement-logiciel { --tint: 242 65 107; }
  .thumb::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(70% 80% at 50% 115%, rgb(var(--tint) / 0.42), transparent 70%), radial-gradient(50% 50% at 50% -10%, rgb(255 255 255 / 0.06), transparent 70%);
  }
  .dots {
    position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(rgb(255 255 255 / 0.09) 1px, transparent 1.2px) 0 0 / 16px 16px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000, transparent);
  }
  /* port of React Bits GlareHover: a light sheen crosses the thumbnail on hover */
  .thumb::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(-45deg, transparent 60%, rgb(255 255 255 / 0.1) 70%, transparent 80%) -100% -100% / 250% 250% no-repeat;
    transition: background-position 0.9s var(--ease-out);
  }
  :global(.pcard:hover) .thumb::after { background-position: 100% 100%; }
  .t-name { font-size: clamp(1.15rem, 7.5cqi, 2.6rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: var(--fg); }
  .logos { display: flex; gap: 2.4cqi; }
  .logos li {
    width: clamp(36px, 11cqi, 68px); aspect-ratio: 1; border-radius: 27%; display: grid; place-items: center;
    background: linear-gradient(#fff, #e9e9ee); box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.8), inset 0 -1px 0 rgb(0 0 0 / 0.08);
    transition: transform 0.5s var(--spring); transition-delay: calc(var(--n, 0) * 35ms);
  }
  .logos li.dark { background: linear-gradient(#2a2a2e, #18181b); box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.8), inset 0 0 0 1px rgb(255 255 255 / 0.12); }
  .logos li:nth-child(2) { --n: 1; } .logos li:nth-child(3) { --n: 2; } .logos li:nth-child(4) { --n: 3; } .logos li:nth-child(5) { --n: 4; }
  :global(.pcard:hover) .logos li { transform: translateY(-5px); }
  .logos img { width: 60%; height: 60%; object-fit: contain; }
</style>
