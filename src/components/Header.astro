---
import { Image } from "astro:assets";
import memoji from "../assets/portraits/memoji.png";
import { UI, LANG, LOCALES, href, alternatePath, type Locale } from "../data/site";
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const ui = UI[locale];
const links = [
  { key: "/projects", label: ui.nav.projects },
  { key: "/about", label: ui.nav.about },
  { key: "/contact", label: ui.nav.contact },
];
const current = (key: string) => path === href(locale, key) || path.startsWith(`${href(locale, key)}/`);
---

<header class="header">
  <div class="bar">
    <a class="brand" href={href(locale, "/")} aria-label={`Jules Royet, ${ui.nav.home}`}>
      <Image src={memoji} alt="" width={28} height={28} widths={[28, 56, 84]} sizes="28px" format="avif" quality={85} loading="eager" />
      <span>Jules Royet</span>
    </a>
    <nav class="nav" aria-label={{ fr: "Navigation principale", en: "Main navigation", es: "Navegación principal" }[locale]}>
      <ul role="list">
        {links.map((l) => <li><a href={href(locale, l.key)} aria-current={current(l.key) ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <button class="icon lang" popovertarget="langs">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9M12 3C9.5 5.7 8.2 8.7 8.2 12s1.3 6.3 3.8 9" /></svg>
        <span class="visually-hidden">{ui.langMenu}, </span><span>{locale.toUpperCase()}</span>
      </button>
      <div id="langs" class="langs" popover>
        <ul role="list">
          {LOCALES.map((l) => <li><a href={alternatePath(path, l)} hreflang={l} lang={l} data-lang={l} data-astro-prefetch="viewport" aria-current={l === locale ? "true" : undefined}>{LANG[l].name}</a></li>)}
        </ul>
      </div>
      <button class="icon theme" type="button" data-theme-toggle aria-pressed="true" aria-label={ui.themeDark}>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z" /></svg>
      </button>
      <button class="menu-btn" popovertarget="menu" aria-haspopup="dialog" aria-label={ui.menu}>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div id="menu" class="menu" popover role="dialog" aria-label={ui.menu}>
    <div class="menu-top">
      <span class="small muted">{ui.location}</span>
      <button popovertarget="menu" popovertargetaction="hide" class="close" aria-label={ui.close}><span></span><span></span></button>
    </div>
    <ul role="list">
      <li><a href={href(locale, "/")}>{ui.nav.home}</a></li>
      {links.map((l) => <li><a href={href(locale, l.key)} aria-current={current(l.key) ? "page" : undefined}>{l.label}</a></li>)}
    </ul>
    <ul class="menu-langs" role="list" aria-label={ui.langMenu}>
      {LOCALES.map((l) => <li><a href={alternatePath(path, l)} hreflang={l} lang={l} data-lang={l} data-astro-prefetch="viewport" aria-current={l === locale ? "true" : undefined}>{LANG[l].name}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .header { position: fixed; inset: 0 0 auto; z-index: 50; view-transition-name: header; }
  .bar {
    display: flex; align-items: center; gap: 1.5rem; height: var(--header-h); padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--bg) 72%, transparent); -webkit-backdrop-filter: saturate(1.6) blur(16px); backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--t-sm); font-weight: 600; letter-spacing: -0.01em; min-height: 2.75rem; }
  /* padding keeps the whole head inside the disc (the source fills its square edge to edge) */
  .brand :global(img) { width: 30px; height: 30px; padding: 3px 3px 2px; object-fit: contain; border-radius: 50%; background: var(--card-2); transition: transform 0.5s var(--spring); }
  .brand:hover :global(img) { transform: rotate(-10deg) scale(1.08); }
  .nav { margin-inline: auto; display: none; }
  .nav ul { display: flex; gap: 0.25rem; }
  .nav a { position: relative; display: inline-block; font-size: var(--t-sm); color: var(--fg-2); padding: 0.45rem 0.9rem; border-radius: var(--pill); transition: color 0.2s, background-color 0.2s; }
  .nav a:hover { color: var(--fg); background: var(--wash); }
  .nav a[aria-current="page"] { color: var(--fg); }
  .nav a[aria-current="page"]::after { content: ""; position: absolute; left: 50%; bottom: 0.15rem; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--fg); }
  .tools { display: flex; align-items: center; gap: 0.125rem; margin-left: auto; }
  .icon { min-height: 2.75rem; min-width: 2.75rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; padding-inline: 0.5rem; border-radius: var(--pill); color: var(--fg-2); font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.02em; transition: color 0.2s, background-color 0.2s; }
  .icon:hover, .icon:focus-visible, .lang:has(+ .langs:popover-open) { color: var(--fg); background: var(--wash); }
  .icon svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .theme .moon, .theme[aria-pressed="true"] .sun { display: none; }
  .theme[aria-pressed="true"] .moon { display: block; }
  :global(.no-js) .theme { display: none; }
  .lang { anchor-name: --lang; }
  .langs {
    position: fixed; inset: auto; top: calc(var(--header-h) - 0.25rem); right: var(--gutter); margin: 0; padding: 0.35rem; min-width: 10rem;
    border: 1px solid var(--line-2); border-radius: var(--r); background: var(--card); color: var(--fg); box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.4);
    opacity: 0; transform: translateY(-4px); transition: opacity 0.2s var(--ease), transform 0.2s var(--ease-out), display 0.2s allow-discrete, overlay 0.2s allow-discrete;
  }
  @supports (position-anchor: --lang) { .langs { position-anchor: --lang; top: anchor(bottom); right: anchor(right); } }
  .langs:popover-open { opacity: 1; transform: none; }
  @starting-style { .langs:popover-open { opacity: 0; transform: translateY(-4px); } }
  .langs a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.5rem; padding-inline: 0.75rem; border-radius: var(--r-sm); font-size: var(--t-sm); color: var(--fg-2); }
  .langs a:hover { color: var(--fg); background: var(--wash); }
  .langs a[aria-current]::after, .menu-langs a[aria-current]::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--gradient); }
  .langs a[aria-current] { color: var(--fg); }
  .menu-btn, .close { width: 2.75rem; height: 2.75rem; display: grid; place-content: center; gap: 6px; border-radius: var(--pill); }
  .menu-btn span, .close span { display: block; width: 18px; height: 1.5px; background: currentColor; border-radius: 2px; }
  .close span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .close span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  @media (min-width: 900px) { .nav { display: block; } .tools { margin-left: 0; } .menu-btn { display: none; } }

  .menu {
    inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; border: 0; margin: 0;
    padding: 0.5rem var(--gutter) 2.5rem; flex-direction: column; background: color-mix(in srgb, var(--bg) 94%, transparent);
    -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); color: var(--fg);
    transition: opacity 0.35s var(--ease), display 0.35s allow-discrete, overlay 0.35s allow-discrete; opacity: 0;
  }
  .menu:popover-open { display: flex; opacity: 1; }
  @starting-style { .menu:popover-open { opacity: 0; } }
  .menu-top { display: flex; justify-content: space-between; align-items: center; min-height: 2.75rem; }
  .menu ul { margin-top: 2.5rem; display: grid; gap: 0.35rem; }
  .menu li a { display: block; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.035em; padding-block: 0.3rem; }
  .menu li { opacity: 0; transform: translateY(-8px); transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out); }
  .menu:popover-open li { opacity: 1; transform: none; }
  .menu:popover-open li:nth-child(2) { transition-delay: 40ms; } .menu:popover-open li:nth-child(3) { transition-delay: 80ms; } .menu:popover-open li:nth-child(4) { transition-delay: 120ms; }
  @starting-style { .menu:popover-open li { opacity: 0; transform: translateY(-8px); } }
  .menu li a[aria-current="page"] { color: var(--fg-2); }
  .menu .menu-langs { margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .menu .menu-langs a { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.75rem; padding: 0; font-size: var(--t-sm); font-weight: 500; letter-spacing: 0; color: var(--fg-2); }
  .menu .menu-langs a[aria-current] { color: var(--fg); }
</style>
