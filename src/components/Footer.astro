---
import { SITE, UI, t, href, CLUSTERS, CLUSTER_LABEL, type Locale } from "../data/site";
import CopyEmail from "./CopyEmail.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
const d = t(locale);
const year = new Date().getFullYear();
---

<section class="cta-band" id="contact" aria-labelledby="cta-title">
  <div class="wrap inner">
    <p class="status">{ui.status}</p>
    <h2 id="cta-title" class="big" data-split>{ui.contactTitle}</h2>
    <p class="lead">{d.contact.description}</p>
    <div class="actions">
      <a class="btn" href={`mailto:${SITE.email}`} data-magnet data-cursor-label={SITE.email}>{ui.writeMe}</a>
      <CopyEmail locale={locale} />
    </div>
  </div>
</section>
<footer class="footer tint">
  <div class="wrap">
    <div class="cols">
      <nav aria-label={ui.clustersTitle}>
        <h2 class="col-title">{ui.clustersTitle}</h2>
        <ul role="list">{CLUSTERS.map((c) => <li><a href={href(locale, `/expertises/${c.slug}`)}>{CLUSTER_LABEL[c.slug][locale]}</a></li>)}</ul>
      </nav>
      <nav aria-label="Index">
        <h2 class="col-title">Index</h2>
        <ul role="list">
          <li><a href={href(locale, "/projects")}>{ui.nav.projects}</a></li>
          <li><a href={href(locale, "/about")}>{ui.nav.about}</a></li>
          <li><a href={href(locale, "/contact")}>{ui.nav.contact}</a></li>
          <li><a href={SITE.cv} type="application/pdf">CV (PDF)</a></li>
        </ul>
      </nav>
      <nav aria-label={locale === "fr" ? "Réseaux" : "Social"}>
        <h2 class="col-title">{locale === "fr" ? "Ailleurs" : "Elsewhere"}</h2>
        <ul role="list">
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
          <li><a href={SITE.rootme} rel="me noopener" target="_blank">Root-Me</a></li>
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <span>Copyright &copy; {year} Jules Royet. {ui.location}.</span>
      <span class="links"><a href={href(locale, "/legal")}>{ui.legal}</a><a href="https://www.casa-mocha.fr/" rel="noopener" target="_blank">Casa Mocha</a></span>
    </div>
  </div>
</footer>

<style>
  .cta-band { padding-block: var(--section); text-align: center; overflow: hidden; }
  .inner { display: grid; justify-items: center; gap: 1.5rem; }
  .big { font-size: clamp(3rem, 1rem + 10vw, 9rem); font-weight: 700; letter-spacing: -0.05em; line-height: 0.95; }
  .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.75rem; }
  .footer { padding-block: 2.5rem 1.5rem; font-size: var(--t-xs); color: var(--fg-2); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; padding-bottom: 1.75rem; border-bottom: 1px solid rgb(0 0 0 / 0.1); }
  .col-title { font-size: var(--t-xs); font-weight: 600; letter-spacing: 0; color: var(--fg); margin-bottom: 0.6rem; }
  .cols ul { display: grid; gap: 0.25rem; }
  .cols a { display: inline-block; padding-block: 0.3rem; }
  .cols a:hover, .links a:hover { color: var(--fg); text-decoration: underline; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; padding-top: 1rem; }
  .links { display: flex; gap: 1.25rem; }
  .links a { padding-block: 0.3rem; }
</style>
