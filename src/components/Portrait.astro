---
import { Picture } from "astro:assets";
import photo from "../assets/portraits/jules.png";
import { UI, type Locale } from "../data/site";
interface Props { locale: Locale; class?: string; eager?: boolean }
const { locale, class: cls, eager = false } = Astro.props;
---
<figure class:list={["portrait", cls]}>
  {/* Source: the resume photo (427 px) cropped to 4:5 around the face and body axis. shortcut: 342 px wide, so it never displays wider than 20rem; swap in a larger original to raise that cap */}
  <Picture src={photo} alt={UI[locale].portraitAlt} widths={[320, 342]} sizes="(min-width: 900px) 20rem, min(72vw, 20rem)" formats={["avif"]} fallbackFormat="webp" quality={80} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} />
</figure>
<style>
  .portrait { width: 100%; max-width: min(20rem, 72vw); aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--r-lg); background: var(--card-2); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
