---
import Base from "../layouts/Base.astro";
import Memoji from "../components/Memoji.astro";
import { UI, href, type Locale } from "../data/site";
interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
---
<Base locale={locale} title={`404 · ${ui.notFoundTitle}`} description={ui.notFoundText} noindex og="home">
  <section class="nf">
    <div class="wrap inner">
      <Memoji locale={locale} size={96} />
      <h1 class="code" data-pressure aria-label={`404, ${ui.notFoundTitle}`}><span>4</span><span>0</span><span>4</span></h1>
      <p class="req small muted" aria-hidden="true">GET <span class="path" data-404-path></span> → 404</p>
      <p class="title">{ui.notFoundTitle}.</p>
      <p class="lead">{ui.notFoundText}</p>
      <div class="cta">
        <a class="btn" href={href(locale, "/")} data-magnet>{ui.notFoundHome}</a>
        <a class="chev" href={href(locale, "/projects")}>{ui.allProjects}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-items: center; text-align: center; }
  .inner { padding-block: calc(var(--header-h) + 2rem) 3rem; display: grid; justify-items: center; gap: 1rem; }
  /* weight reacts to the pointer (port of React Bits TextPressure, scripts/app.ts) */
  .code { display: flex; justify-content: center; gap: 0.02em; font-size: clamp(6rem, 30vw, 14rem); font-weight: 200; letter-spacing: -0.06em; line-height: 0.85; }
  .code span { display: inline-block; width: 0.64em; text-align: center; font-variant-numeric: tabular-nums; animation: blur-in 1.1s var(--ease-out) backwards; }
  .code span:nth-child(2) { animation-delay: 0.08s; background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .code span:nth-child(3) { animation-delay: 0.16s; }
  .req { font-variant-numeric: tabular-nums; }
  .path { color: var(--fg); }
  .lead { margin-inline: auto; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem 1.5rem; margin-top: 0.75rem; }
</style>
