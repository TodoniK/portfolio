---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import BgVideo from "../components/BgVideo.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Portrait from "../components/Portrait.astro";
import Arrow from "../components/Arrow.astro";
import Stack from "../components/Stack.astro";
import { UI, SITE, t, href, projects, CLUSTERS, CLUSTER_LABEL, type Locale } from "../data/site";
import { EXPERTISES } from "../data/expertises";
import { logo } from "../data/media";

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
const d = t(locale);
const all = projects(locale);
const featured = all.slice(0, 4);
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
const meta =
  locale === "fr"
    ? { title: "Jules Royet | Architecte cloud, DevOps et IA à Bordeaux et Nice", description: "Jules Royet, architecte cloud et DevOps chez Orange. Ingénierie logicielle, infrastructures Azure et agents IA autonomes. Parcours et études de cas entre Bordeaux et Nice." }
    : { title: "Jules Royet | Cloud, DevOps & AI engineer in Bordeaux and Nice", description: "Jules Royet, Cloud & DevOps Architect at Orange. Software engineering, Azure infrastructure and autonomous AI agents. Background and case studies from Bordeaux to Nice, France." };
const log = [
  ...d.about.experiences.map((e) => ({ when: e.period, who: e.company, what: e.role, text: e.description, logo: logo(e.logo), url: e.url })),
  ...d.about.educations.map((e) => ({ when: e.period, who: e.school, what: e.degree, text: e.city, logo: logo(e.logo), url: e.url })),
];
---

<Base locale={locale} title={meta.title} description={meta.description}>
  <section class="hero on-ink" data-hero aria-labelledby="hero-title">
    <div class="hero-media" data-hero-media>
      <BgVideo ids={["hero-16x9", "hero-9x16"]} locale={locale} eager />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-kicker mono" data-hero-fade>
        <span class="pill">{ui.status}</span>
        <span class="muted">{ui.location}</span>
      </p>
      <h1 id="hero-title" class="hero-title">
        <span class="display name" data-hero-name><span>Jules</span> <span>Royet</span></span>
        <span class="role">{d.hero.titleLine1} <span class="muted">{d.hero.titleLine2}</span></span>
      </h1>
      <p class="hero-desc lead" data-hero-fade>{d.hero.description}</p>
      <div class="hero-cta" data-hero-fade>
        <a class="btn" href={href(locale, "/projects")}>{ui.heroCta} <Arrow /></a>
        <a class="btn btn--ghost" href={SITE.cv} type="application/pdf">{ui.heroCv} <Arrow dir="down" /></a>
      </div>
      <a class="scroll-cue mono" href="#manifesto" data-hero-fade><span class="tick" aria-hidden="true"></span>{ui.scroll}</a>
    </div>
  </section>

  <section id="manifesto" class="section manifesto" aria-labelledby="manifesto-title">
    <div class="wrap">
      <SectionHead num="01" label={ui.manifestoTitle} />
      <div class="m-grid">
        <Portrait locale={locale} class="m-portrait" />
        <div class="m-text">
          <h2 id="manifesto-title" class="visually-hidden">{d.about.bioTitle}</h2>
          <p class="statement" data-words>{d.about.bioP1}</p>
          <p class="m-sub muted reveal">{d.about.bioP2}</p>
          <a class="btn btn--ghost reveal" href={href(locale, "/about")}>{ui.background} <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="clusters on-ink grain" data-hscroll aria-labelledby="clusters-title">
    <div class="c-inner">
      <div class="wrap c-head">
        <SectionHead num="02" label={ui.clustersTitle} />
        <h2 id="clusters-title" class="h2" data-split>{ui.clustersTitle}</h2>
        <p class="lead muted">{ui.clustersLead}</p>
      </div>
      <ol class="track" role="list" data-track>
        {CLUSTERS.map((c) => {
          const e = EXPERTISES[c.slug];
          return (
            <li class="panel">
              <div class="frame"><BgVideo ids={[c.video]} locale={locale} controls={false} /></div>
              <div class="p-body">
                <p class="mono p-code"><span>{c.code}</span> {e.projects.length} {locale === "fr" ? "projets" : "projects"}</p>
                <h3 class="h3"><a class="inline-link" href={href(locale, `/expertises/${c.slug}`)}>{CLUSTER_LABEL[c.slug][locale]}</a></h3>
                <p class="muted">{e.sections[0]!.body[locale]}</p>
                <ul role="list" class="p-projects mono">
                  {e.projects.map((id) => byId[id] && <li><a class="link" href={href(locale, `/projects/${id}`)}>{byId[id].title}</a></li>)}
                </ul>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead num="03" label={ui.projectsTitle} />
      <div class="w-head">
        <h2 id="work-title" class="h2" data-split>{d.projects.headline}</h2>
        <p class="lead muted">{d.projects.description}</p>
      </div>
      <div class="w-grid">
        {featured.map((p, i) => <div class:list={["w-item", `w${i}`, "reveal"]}><ProjectCard project={p} locale={locale} size={i === 0 ? "lg" : "md"} /></div>)}
      </div>
      <div class="w-more"><a class="btn" href={href(locale, "/projects")}>{ui.allProjects} ({all.length}) <Arrow /></a></div>
    </div>
  </section>

  <Stack locale={locale} />

  <section class="section log" aria-labelledby="log-title">
    <div class="wrap">
      <SectionHead num="04" label={ui.timelineTitle} />
      <h2 id="log-title" class="h2" data-split>{ui.timelineTitle}</h2>
      <ol class="entries" role="list" data-timeline>
        <span class="line" aria-hidden="true" data-line></span>
        {log.map((l) => (
          <li class="entry reveal">
            <p class="mono when">{l.when}</p>
            <div class="what">
              {l.logo && <Image src={l.logo} alt="" width={40} height={40} class="logo" />}
              <div>
                <h3 class="h3">{l.what}</h3>
                <p class="mono muted">{l.url ? <a class="link" href={l.url} rel="noopener" target="_blank">{l.who}</a> : l.who}</p>
              </div>
            </div>
            <p class="muted text">{l.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero-media { position: absolute; inset: 0; z-index: -2; transform-origin: 50% 40%; overflow: hidden; }
  .hero-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(15 16 17 / 0.55) 0%, rgb(15 16 17 / 0) 30%, rgb(15 16 17 / 0.2) 55%, rgb(15 16 17 / 0.92) 100%); }
  .hero-inner { padding-top: calc(var(--header-h) + 3rem); padding-bottom: clamp(2rem, 6vw, 4rem); display: grid; gap: 1.5rem; }
  .hero-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .hero-title { display: grid; gap: 1rem; font-weight: inherit; }
  .name { display: block; font-stretch: 125%; font-size: min(21vw, 13rem); animation: hero-in 1.1s var(--ease-out) backwards; }
  .name > span { display: block; }
  @media (min-width: 900px) { .name { font-size: min(9.6vw, 13rem); white-space: nowrap; } .name > span { display: inline; } }
  .role { font-size: var(--step-2); font-weight: 560; line-height: 1.15; letter-spacing: -0.015em; max-width: 30ch; animation: hero-in 1.1s var(--ease-out) 0.12s backwards; }
  .hero-desc { animation: hero-in 1.1s var(--ease-out) 0.22s backwards; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; animation: hero-in 1.1s var(--ease-out) 0.3s backwards; }
  /* transform only: opacity 0 would postpone LCP */
  @keyframes hero-in { from { transform: translateY(18%); } }
  .scroll-cue { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--fg-muted); justify-self: start; margin-top: 1rem; min-height: 2.75rem; }
  .tick { width: 1px; height: 2.5rem; background: currentColor; transform-origin: top; animation: tick 2s var(--ease-io) infinite; }
  @keyframes tick { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (min-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr 1fr; align-items: end; }
    .hero-kicker, .hero-title { grid-column: 1 / -1; }
    .hero-desc { grid-column: 1; }
    .hero-cta { grid-column: 2; justify-self: end; }
  }

  /* manifesto */
  .m-grid { display: grid; gap: clamp(2rem, 6vw, 5rem); }
  .statement { font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem); font-weight: 560; line-height: 1.12; letter-spacing: -0.02em; }
  .m-text { display: grid; gap: 2rem; align-content: start; justify-items: start; }
  .m-sub { max-width: 56ch; }
  @media (min-width: 900px) { .m-grid { grid-template-columns: 4fr 7fr; align-items: start; } }

  /* clusters */
  .clusters { overflow: hidden; }
  .c-inner { padding-block: var(--section); display: grid; grid-template-columns: minmax(0, 1fr); }
  .c-head { display: grid; gap: 1.5rem; }
  .c-head .lead { margin-bottom: 3rem; }
  .track { display: grid; gap: 1.25rem; padding-inline: var(--gutter); }
  .panel { display: grid; background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .frame { position: relative; aspect-ratio: 4 / 3; max-height: 42svh; width: 100%; }
  .p-body { padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: 1rem; align-content: start; }
  .p-code { color: var(--fg-muted); }
  .p-code span { color: var(--signal); }
  .p-projects { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.75rem; }
  .p-projects a { text-decoration: none; }
  @media (min-width: 1024px) {
    .c-inner { min-height: 100svh; align-content: center; padding-block: calc(var(--header-h) + 1.5rem) 2rem; }
    .c-head { grid-template-columns: 1fr 1fr; align-items: end; }
    .c-head :global(.sec-head) { grid-column: 1 / -1; }
    .c-head .lead { margin-bottom: 2.5rem; }
    .track { display: flex; gap: 1.5rem; min-width: 0; padding-right: 10vw; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
    .track > li { scroll-snap-align: start; }
    :global(.is-pinned) .track { overflow: visible; }
    .panel { position: relative; top: 0; flex: 0 0 min(72vw, 64rem); grid-template-columns: 1.1fr 1fr; }
    .frame { aspect-ratio: auto; max-height: none; min-height: min(24rem, 46svh); }
    .c-head .h2 { font-size: clamp(2.8rem, 5vw, 5rem); }
    .c-head :global(.sec-head) { margin-bottom: 1.5rem; }
  }

  /* selected work */
  .w-head { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .w-grid { display: grid; gap: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 3vw, 3rem); }
  .w-more { margin-top: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 720px) { .w-grid { grid-template-columns: repeat(12, 1fr); } .w-item { grid-column: span 6; } }
  @media (min-width: 1024px) {
    .w-head { grid-template-columns: 1.2fr 1fr; align-items: end; }
    .w0 { grid-column: 1 / span 7; } .w1 { grid-column: 9 / span 4; margin-top: 30%; }
    .w2 { grid-column: 2 / span 5; } .w3 { grid-column: 7 / span 6; margin-top: 18%; }
  }

  /* career log */
  .entries { position: relative; margin-top: clamp(2.5rem, 6vw, 5rem); display: grid; gap: 0; padding-left: 1.5rem; }
  .line { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--signal); transform-origin: top; }
  .entries::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .entry { display: grid; gap: 0.75rem; padding-block: 1.75rem; border-bottom: 1px solid var(--line); position: relative; }
  .entry::before { content: ""; position: absolute; left: calc(-1.5rem - 4px); top: 2.2rem; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 1px solid var(--signal); }
  .when { color: var(--accent); }
  .what { display: flex; gap: 1rem; align-items: center; }
  .what :global(.logo) { width: 40px; height: 40px; object-fit: contain; border-radius: var(--radius); background: #fff; padding: 4px; border: 1px solid var(--line); }
  .text { max-width: 70ch; }
  @media (min-width: 1024px) { .entry { grid-template-columns: 14rem 1fr 1.2fr; gap: 2rem; align-items: start; } }
</style>
