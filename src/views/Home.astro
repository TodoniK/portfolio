---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Memoji from "../components/Memoji.astro";
import Rotator from "../components/Rotator.astro";
import Stack from "../components/Stack.astro";
import { UI, SITE, t, href, pick, projects, CLUSTERS, CLUSTER_LABEL, CLUSTER_BLURB, type Locale } from "../data/site";
import { EXPERTISES } from "../data/expertises";
import { PROJECT_VISUAL, brand, type Brand } from "../data/brands";
import { logo } from "../data/media";

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
const d = t(locale);
const all = projects(locale);
const featured = all.slice(0, 6);
const meta = pick({
  fr: { title: "Jules Royet | Architecte Cloud & IA", description: "Jules Royet, architecte cloud et IA chez Orange. Architecture cible Azure, IA générative en production et agents IA autonomes. Parcours et études de cas." },
  en: { title: "Jules Royet | Cloud & AI Solutions Architect", description: "Jules Royet, Cloud & AI architect at Orange. Azure target architecture, generative AI in production and autonomous AI agents. Background and case studies." },
  es: { title: "Jules Royet | Arquitecto Cloud e IA", description: "Jules Royet, arquitecto cloud e IA en Orange. Arquitectura objetivo en Azure, IA generativa en producción y agentes de IA autónomos. Trayectoria y casos de estudio." },
}, locale);
const log = [
  ...d.about.experiences.map((e) => ({ when: e.period, who: e.company, what: e.role, logo: logo(e.logo), url: e.url })),
  ...d.about.educations.map((e) => ({ when: e.period, who: e.school, what: e.degree, logo: logo(e.logo), url: e.url })),
];
/** The most used tools across an area's projects, for the expertise cards. */
const areaBrands = (slug: keyof typeof EXPERTISES) => {
  const count = new Map<Brand, number>();
  for (const id of EXPERTISES[slug].projects) for (const b of PROJECT_VISUAL[id]?.brands ?? []) count.set(b, (count.get(b) ?? 0) + 1);
  return [...count].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([b]) => brand(b));
};
const letters = (s: string) => [...s];
/** Manifesto words in groups of three, each lit by its own scroll timeline (global.css). */
const groups = (s: string) => s.split(" ").reduce<string[]>((acc, w, i) => (i % 3 ? (acc[acc.length - 1] += ` ${w}`) : acc.push(w), acc), []);
---

<Base locale={locale} title={meta.title} description={meta.description}>
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="aurora" data-aurora aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <Memoji locale={locale} />
      <p class="status"><span class="shiny">{ui.status} · {ui.location}</span></p>
      <h1 id="hero-title" class="hero-title">
        <span class="visually-hidden">Jules Royet, {ui.heroKicker}</span>
        <span class="name blur-in" aria-hidden="true">{letters("Jules Royet").map((c) => <span>{c === " " ? "\u00a0" : c}</span>)}</span>
      </h1>
      <p class="role" aria-hidden="true">{ui.heroKicker.split(" · ").map((r, i) => <>{i > 0 && <span class="sep"> · </span>}<span>{r}</span></>)}</p>
      <p class="kinetic">{ui.heroBuild} <Rotator words={ui.heroWords} /></p>
      <div class="hero-cta">
        <a class="btn star" href={href(locale, "/projects")} data-magnet><span>{ui.heroCta}</span></a>
        <a class="btn btn--ghost" href={SITE.cv} type="application/pdf">{ui.heroCv}</a>
      </div>
    </div>
  </section>

  <section class="section manifesto" aria-labelledby="manifesto-title">
    <div class="wrap">
      <SectionHead label={ui.manifestoTitle} />
      <h2 id="manifesto-title" class="statement" data-words>{groups(ui.manifesto).map((g, i) => <>{i > 0 && " "}<span class="w">{g}</span></>)}</h2>
      <ul class="stats" role="list">
        {ui.stats.map(([n, l]) => (
          <li class="card stat reveal" data-spotlight><span class="n num" data-count>{n}</span><span class="l">{l}</span></li>
        ))}
      </ul>
      <a class="chev more" href={href(locale, "/about")}>{ui.background}</a>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="head">
        <div>
          <SectionHead label={ui.projectsTitle} />
          <h2 id="work-title" class="headline" data-split>{d.projects.headline}</h2>
        </div>
        <a class="chev" href={href(locale, "/projects")}>{ui.allProjects} ({all.length})</a>
      </div>
      <ul class="grid" role="list">
        {featured.map((p) => <li class="reveal"><ProjectCard project={p} locale={locale} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section areas" aria-labelledby="areas-title">
    <div class="wrap">
      <SectionHead label={ui.clustersTitle} />
      <h2 id="areas-title" class="headline" data-split>{ui.clustersHeading}</h2>
      <p class="lead">{ui.clustersLead}</p>
      <ol class="area-list" role="list">
        {CLUSTERS.map((c) => (
          <li class="card area reveal" data-spotlight>
            <p class="code num">{c.code}</p>
            <h3 class="h3"><a class="a-link" href={href(locale, `/expertises/${c.slug}`)}>{CLUSTER_LABEL[c.slug][locale]}</a></h3>
            <p class="muted small">{CLUSTER_BLURB[c.slug][locale]}</p>
            <ul class="a-logos" role="list">{areaBrands(c.slug).map((b) => <li class:list={{ dark: b.dark }}><img src={b.src} alt={b.name} width="20" height="20" loading="lazy" decoding="async" /></li>)}</ul>
            <p class="small a-count">{EXPERTISES[c.slug].projects.length} {pick({ fr: "projets", en: "projects", es: "proyectos" }, locale)} <span aria-hidden="true">→</span></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Stack locale={locale} />

  <section class="section log" aria-labelledby="log-title">
    <div class="wrap">
      <SectionHead label={ui.timelineTitle} />
      <h2 id="log-title" class="headline" data-split>{pick({ fr: "Un parcours en production.", en: "A career in production.", es: "Una trayectoria en producción." }, locale)}</h2>
      <div class="timeline">
      <span class="line" aria-hidden="true"></span>
      <ol class="entries" role="list">
        {log.map((l) => (
          <li class="entry reveal">
            <span class="node" aria-hidden="true">{l.logo && <Image src={l.logo} alt="" width={40} height={40} class="logo" />}</span>
            <div>
              <h3 class="e-title">{l.what}</h3>
              <p class="small muted">{l.url ? <a class="link" href={l.url} rel="noopener" target="_blank">{l.who}</a> : l.who} · {l.when}</p>
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; padding-block: calc(var(--header-h) + 3.5rem) 3.5rem; }
  @media (min-width: 640px) { .hero { min-height: min(92svh, 52rem); padding-bottom: 4rem; } }
  .hero-inner { display: grid; justify-items: center; text-align: center; gap: 1rem; }
  .hero-title { line-height: 1; margin-top: 0.25rem; }
  .name { display: inline-flex; font-size: var(--t-hero); font-weight: 650; letter-spacing: -0.05em; line-height: 1; }
  .role { font-size: var(--t-lg); color: var(--fg-2); }
  :global(.is-intro) .role { animation: rise 0.8s var(--ease-out) 1.2s backwards; }
  @media (max-width: 639px) { .role { display: grid; } .role .sep { display: none; } }
  .kinetic { font-size: var(--t-xl); font-weight: 550; letter-spacing: -0.025em; min-height: 1.3em; }
  /* the longest words do not fit next to the verb on phones */
  @media (max-width: 639px) { .kinetic :global(.rotator-wrap) { display: block; } }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.75rem; }

  /* manifesto */
  .statement { font-size: var(--t-3xl); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; max-width: 20em; margin-top: 0.75rem; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: clamp(2rem, 5vw, 3rem); }
  .stat { padding: 1.25rem; display: grid; gap: 0.4rem; align-content: space-between; min-height: 7.5rem; border-radius: var(--r); }
  .stat .n { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1; }
  .stat .l { color: var(--fg-2); font-size: var(--t-sm); }
  .more { margin-top: 1rem; }
  @media (min-width: 900px) { .stats { grid-template-columns: repeat(4, 1fr); } }

  /* work */
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 2rem; margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .head :global(.eyebrow) { margin-bottom: 0.75rem; }
  .grid { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  /* areas */
  .areas .lead { margin-top: 0.75rem; }
  .area-list { display: grid; gap: 1rem; margin-top: clamp(1.75rem, 4vw, 2.5rem); }
  .area { padding: 1.5rem; display: grid; gap: 0.6rem; align-content: start; }
  .code { font-size: var(--t-xs); color: var(--fg-2); }
  .a-link::after { content: ""; position: absolute; inset: 0; z-index: 3; }
  .a-logos { display: flex; gap: 0.4rem; margin-top: 0.5rem; }
  .a-logos li { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: #f2f2f5; }
  .a-logos li.dark { background: #232327; box-shadow: inset 0 0 0 1px var(--line-2); }
  .a-logos img { width: 20px; height: 20px; object-fit: contain; }
  .a-count { color: var(--fg-2); margin-top: 0.25rem; }
  .a-count span { display: inline-block; transition: transform 0.3s var(--ease-out); }
  .area:hover .a-count span { transform: translateX(4px); }
  @media (min-width: 900px) { .area-list { grid-template-columns: repeat(3, 1fr); } }

  /* career log */
  .timeline { position: relative; margin-top: clamp(1.75rem, 4vw, 2.5rem); max-width: 48rem; }
  .entries { display: grid; padding-left: 3.5rem; }
  .timeline::before, .line { content: ""; position: absolute; left: 20px; top: 1.75rem; bottom: 1.75rem; width: 1px; background: var(--line-2); }
  .line { background: var(--gradient); transform-origin: top; width: 2px; left: 19.5px; }
  /* z-index on the entry itself: reveal transforms make each entry a stacking context, which would trap the logo under the line */
  .entry { position: relative; z-index: 1; padding-block: 0.9rem; }
  .node { position: absolute; left: -3.5rem; top: 0.75rem; z-index: 2; width: 40px; height: 40px; border-radius: 12px; background: #fff; display: grid; place-items: center; box-shadow: 0 0 0 4px var(--bg), inset 0 0 0 1px var(--line); }
  .node :global(.logo) { width: 26px; height: 26px; object-fit: contain; }
  .e-title { font-size: var(--t-body); font-weight: 600; letter-spacing: -0.015em; }
</style>
