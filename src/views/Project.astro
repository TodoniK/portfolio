---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ProjectThumb from "../components/ProjectThumb.astro";
import { UI, SITE, href, projects, CLUSTER_LABEL, type Locale } from "../data/site";
import { breadcrumb, projectSchema } from "../data/schema";

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const ui = UI[locale];
const list = projects(locale);
const i = list.findIndex((p) => p.id === slug);
const p = list[i]!;
const a = p.article;
const prev = list[(i - 1 + list.length) % list.length]!;
const next = list[(i + 1) % list.length]!;
const title = locale === "fr" ? `${p.title} : étude de cas` : `${p.title}: case study`;
const clean = (s: string) => s.replace(/[.:]$/, "");
const schema = [
  breadcrumb(locale, [[ui.nav.projects, href(locale, "/projects")], [p.title, href(locale, `/projects/${p.id}`)]]),
  projectSchema(locale, p, `/og/${locale === "fr" ? "" : "en-"}projects-${p.id}.jpg`),
];
const info = [
  [locale === "fr" ? "Rôle" : "Role", a.role[locale]],
  [locale === "fr" ? "Période" : "Timeline", a.timeline[locale]],
  [locale === "fr" ? "Contexte" : "Context", a.clientOrContext[locale]],
  [locale === "fr" ? "Plateforme" : "Infra", a.infrastructure[locale]],
];
---
<Base locale={locale} title={title} description={a.summary[locale]} schema={schema}>
  <PageHero locale={locale} kicker={`${p.tag} · ${a.timeline[locale]}`} title={p.title} lead={clean(a.headline[locale])} crumbs={[[ui.nav.projects, href(locale, "/projects")], [p.title, href(locale, `/projects/${p.id}`)]]}>
    <div class="links">
      {p.previewUrl && <a class="btn" href={p.previewUrl} rel="noopener" target="_blank" data-magnet>{locale === "fr" ? "Démo en direct" : "Live preview"}</a>}
      {p.githubUrl && <a class="chev" href={p.githubUrl} rel="noopener" target="_blank">{locale === "fr" ? "Code source" : "Source code"}</a>}
      {p.confidential && <span class="chip">{locale === "fr" ? "Projet confidentiel" : "Confidential project"}</span>}
    </div>
  </PageHero>

  <div class="wrap">
    <div class="cover" data-cover><ProjectThumb id={p.id} cluster={p.clusters[0]} eager /></div>
  </div>

  <section class="wrap facts" aria-label={locale === "fr" ? "En bref" : "At a glance"}>
    <dl class="info">{info.map(([k, v]) => <div><dt class="small muted">{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>

  <article class="section body">
    <div class="wrap layout">
      <div class="main prose">
        <p class="summary">{a.summary[locale]}</p>
        <h2 class="h3">{clean(a.problemTitle[locale])}</h2>
        <p>{a.problemBody[locale]}</p>
        <h2 class="h3">{clean(a.architectureTitle[locale])}</h2>
        <p>{a.architectureBody[locale]}</p>
        <h2 class="h3">{clean(a.challengesTitle[locale])}</h2>
        <ol class="challenges" role="list">
          {a.challenges.map((c, n) => <li><span class="n num">{n + 1}</span><p>{c[locale]}</p></li>)}
        </ol>
      </div>
      <aside class="side">
        <div class="card box">
          <p class="small muted">{locale === "fr" ? "Stack technique" : "Tech stack"}</p>
          <ul role="list" class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>
        </div>
        <div class="card box">
          <p class="small muted">{ui.related}</p>
          <ul role="list" class="rel">{p.clusters.map((c) => <li><a class="chev" href={href(locale, `/expertises/${c}`)}>{CLUSTER_LABEL[c][locale]}</a></li>)}</ul>
        </div>
        <div class="card box">
          <p class="small muted">{ui.discuss}</p>
          <p class="small">{ui.discussText}</p>
          <a class="link small" href={`mailto:${SITE.email}?subject=${encodeURIComponent(p.title)}`}>{SITE.email}</a>
        </div>
      </aside>
    </div>
    <div class="wrap">
      <h2 class="title metrics-title" data-split>{clean(a.metricsTitle[locale])}</h2>
      <dl class="metrics">
        {a.metrics.map((m) => <div class="card metric reveal" data-spotlight><dd class="num" data-count>{m.value}</dd><dt class="small muted">{m.label[locale]}</dt></div>)}
      </dl>
    </div>
  </article>

  <nav class="wrap pager" aria-label={locale === "fr" ? "Projets voisins" : "Adjacent projects"}>
    <a class="card" href={href(locale, `/projects/${prev.id}`)} rel="prev" data-spotlight><span class="small muted">‹ {ui.prev}</span><span class="h3">{prev.title}</span></a>
    <a class="card nx" href={href(locale, `/projects/${next.id}`)} rel="next" data-spotlight><span class="small muted">{ui.next} ›</span><span class="h3">{next.title}</span></a>
  </nav>
</Base>
<style>
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 0.5rem; }
  .cover { padding: 0.5rem; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--card); transform-origin: 50% 0; }
  .cover :global(.thumb) { aspect-ratio: 21 / 9; }
  @media (max-width: 639px) { .cover :global(.thumb) { aspect-ratio: 16 / 10; } }
  .facts { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .info { display: grid; gap: 1.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .info dd { margin-top: 0.25rem; font-weight: 600; letter-spacing: -0.015em; }
  .layout { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .main :global(h2) { margin-top: 2.75rem; margin-bottom: 0.9rem; }
  .summary { font-size: var(--t-xl); font-weight: 550; color: var(--fg); letter-spacing: -0.025em; line-height: 1.25; }
  .challenges { display: grid; gap: 1.25rem; }
  .challenges li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.75rem; align-items: start; }
  .challenges .n { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-2); font-size: var(--t-sm); font-weight: 600; }
  .side { display: grid; gap: 0.75rem; align-content: start; }
  .box { padding: 1.4rem; display: grid; gap: 0.75rem; border-radius: var(--r); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .rel { display: grid; }
  .metrics-title { margin-top: var(--section); margin-bottom: 2rem; }
  .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .metric { padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column-reverse; justify-content: space-between; gap: 1rem; min-height: 8rem; border-radius: var(--r); }
  .metric dd { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem); font-weight: 650; letter-spacing: -0.045em; line-height: 1; }
  .pager { display: grid; gap: 0.75rem; margin-bottom: var(--section); }
  .pager a { padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 0.4rem; border-radius: var(--r); }
  @media (min-width: 720px) { .pager { grid-template-columns: 1fr 1fr; } .nx { text-align: right; justify-items: end; } }
  @media (min-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 1fr) 21rem; }
    .side { position: sticky; top: calc(var(--header-h) + 1.5rem); }
    .metrics { grid-template-columns: repeat(4, 1fr); }
  }
</style>
