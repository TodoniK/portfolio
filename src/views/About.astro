---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Portrait from "../components/Portrait.astro";
import SectionHead from "../components/SectionHead.astro";
import { UI, SITE, t, href, CLUSTERS, CLUSTER_LABEL, type Locale } from "../data/site";
import { breadcrumb, profilePage } from "../data/schema";
import { logo } from "../data/media";

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
const d = t(locale).about;
const meta = locale === "fr"
  ? { title: "Parcours et expertises cloud & DevOps", description: "Jules Royet, architecte cloud et DevOps chez Orange, diplômé de l'ENSEIRB-MATMECA. Parcours, compétences et projets, de Bayonne à Nice." }
  : { title: "About: cloud & DevOps engineering experience", description: "Meet Jules Royet, Cloud & DevOps Architect at Orange and ENSEIRB-MATMECA graduate. Engineering experience, technical skills and projects, from Bayonne to Nice." };
const schema = [breadcrumb(locale, [[ui.nav.about, href(locale, "/about")]]), profilePage(locale)];
---
<Base locale={locale} title={meta.title} description={meta.description} schema={schema}>
  <PageHero locale={locale} kicker={ui.heroKicker} title={d.bioTitle} crumbs={[[ui.nav.about, href(locale, "/about")]]} />

  <section class="section-tight">
    <div class="wrap bio">
      <Portrait locale={locale} eager />
      <div class="prose text">
        <p class="first">{d.bioP1}</p>
        <p>{d.bioP2}</p>
        <p>{d.bioP3}</p>
        <p>
          {locale === "fr" ? "Mes domaines : " : "My areas: "}
          {CLUSTERS.map((c, i) => <><a href={href(locale, `/expertises/${c.slug}`)}>{CLUSTER_LABEL[c.slug][locale]}</a>{i < CLUSTERS.length - 1 ? ", " : "."}</>)}
          {" "}{locale === "fr" ? "Les réalisations sont détaillées dans les " : "Work is detailed in the "}<a href={href(locale, "/projects")}>{locale === "fr" ? "études de cas" : "case studies"}</a>.
        </p>
        <div class="ctas"><a class="btn" href={SITE.cv} type="application/pdf" data-magnet>{ui.heroCv}</a><a class="chev" href={href(locale, "/contact")}>{ui.nav.contact}</a></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="xp">
    <div class="wrap">
      <SectionHead label={ui.experienceTitle} />
      <h2 id="xp" class="headline" data-split>{locale === "fr" ? "Expériences." : "Experience."}</h2>
      <ol class="rows" role="list">
        {d.experiences.map((e) => {
          const l = logo(e.logo);
          return (
            <li class="card row reveal" data-spotlight>
              <div class="who">
                {l && <span class="lg"><Image src={l} alt="" width={36} height={36} /></span>}
                <div><p class="small muted">{e.period}</p><h3 class="e-title">{e.role}</h3><p class="small">{e.url ? <a class="link" href={e.url} rel="noopener" target="_blank">{e.company}</a> : e.company}</p></div>
              </div>
              <p class="muted">{e.description}</p>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="edu">
    <div class="wrap two">
      <div>
        <SectionHead label={ui.educationTitle} />
        <h2 id="edu" class="title">{ui.educationTitle}</h2>
        <ul role="list" class="list">
          {d.educations.map((e) => <li><p class="small muted">{e.period} · {e.city}</p><h3 class="e-title">{e.degree}</h3><p class="small">{e.url ? <a class="link" href={e.url} rel="noopener" target="_blank">{e.school}</a> : e.school}</p></li>)}
        </ul>
      </div>
      <div>
        <SectionHead label={ui.certificationsTitle} />
        <h2 class="title">{ui.certificationsTitle}</h2>
        <ul role="list" class="list">
          {d.certifications.map((c) => <li><p class="small muted">{c.year} · {c.issuer}</p><h3 class="e-title">{c.url ? <a href={c.url} rel="noopener" target="_blank" class="hover-link">{c.name}</a> : c.name}</h3></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="skills">
    <div class="wrap two">
      <div>
        <SectionHead label={ui.skillsTitle} />
        <h2 id="skills" class="title">{ui.skillsTitle}</h2>
        <ul role="list" class="skills">{d.skills.map((s) => <li class="reveal">{s}</li>)}</ul>
      </div>
      <div>
        <SectionHead label={ui.languages} />
        <h2 class="title">{ui.languages}</h2>
        <ul role="list" class="skills">{ui.languagesList.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .bio { display: grid; gap: clamp(2rem, 6vw, 5rem); }
  .first { font-size: var(--t-xl); font-weight: 550; color: var(--fg); letter-spacing: -0.025em; line-height: 1.25; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
  .rows { display: grid; gap: 0.75rem; margin-top: clamp(2rem, 5vw, 3rem); }
  .row { display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 1.75rem); border-radius: var(--r); }
  .who { display: flex; gap: 1rem; align-items: flex-start; }
  .lg { flex: none; width: 48px; height: 48px; border-radius: 14px; background: #fff; display: grid; place-items: center; }
  .lg :global(img) { width: 32px; height: 32px; object-fit: contain; }
  .e-title { font-size: var(--t-body); font-weight: 600; letter-spacing: -0.022em; margin-block: 0.15rem; }
  .two { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .two .title { margin-bottom: 1.5rem; }
  .list { display: grid; }
  .list li { display: grid; gap: 0.15rem; padding-block: 1.1rem; border-top: 1px solid var(--line); }
  .hover-link:hover { color: var(--link); }
  .skills { display: grid; }
  .skills li { padding-block: 0.75rem; border-top: 1px solid var(--line); font-size: var(--t-body); font-weight: 500; letter-spacing: -0.02em; }
  @media (min-width: 900px) {
    .bio { grid-template-columns: 4fr 7fr; align-items: start; }
    .row { grid-template-columns: 1fr 1.3fr; gap: 2.5rem; }
    .two { grid-template-columns: 1fr 1fr; }
  }
</style>
