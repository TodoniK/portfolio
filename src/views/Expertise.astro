---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHead from "../components/SectionHead.astro";
import { UI, SITE, href, projects, CLUSTERS, CLUSTER_LABEL, type Locale, type ExpertiseSlug } from "../data/site";
import { EXPERTISES } from "../data/expertises";
import { breadcrumb, faqSchema, PERSON_ID } from "../data/schema";

interface Props { locale: Locale; slug: ExpertiseSlug }
const { locale, slug } = Astro.props;
const ui = UI[locale];
const e = EXPERTISES[slug];
const cluster = CLUSTERS.find((c) => c.slug === slug)!;
const related = projects(locale).filter((p) => (e.projects as readonly string[]).includes(p.id));
const others = CLUSTERS.filter((c) => c.slug !== slug);
const url = new URL(href(locale, `/expertises/${slug}`), SITE.url).href;
const schema = [
  breadcrumb(locale, [[e.title[locale], href(locale, `/expertises/${slug}`)]]),
  { "@type": "WebPage", "@id": `${url}#webpage`, url, name: e.title[locale], description: e.summary[locale], inLanguage: locale, author: { "@id": PERSON_ID }, about: e.title[locale] },
  faqSchema(locale, slug),
];
---
<Base locale={locale} title={e.title[locale]} description={e.summary[locale]} schema={schema}>
  <PageHero locale={locale} kicker={`${cluster.code} · ${ui.location}`} title={e.title[locale]} lead={e.summary[locale]} crumbs={[[e.title[locale], href(locale, `/expertises/${slug}`)]]} />

  <article class="section">
    <div class="wrap sections">
      {e.sections.map((s, i) => (
        <section class="card block reveal" data-spotlight>
          <p class="num">{String(i + 1).padStart(2, "0")}</p>
          <h2 class="h3">{s[locale]}</h2>
          <p class="body">{s.body[locale]}</p>
        </section>
      ))}
    </div>
  </article>

  <section class="section" aria-labelledby="related">
    <div class="wrap">
      <SectionHead label={ui.relatedWork} />
      <h2 id="related" class="headline" data-split>{ui.relatedWork}</h2>
      <ol class="grid" role="list">
        {related.map((p) => <li class="reveal"><ProjectCard project={p} locale={locale} /></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap faq">
      <div>
        <SectionHead label={ui.faq} />
        <h2 id="faq" class="headline">{ui.faq}</h2>
      </div>
      <div class="qa">
        {e.questions.map((q) => (
          <details>
            <summary class="h3">{q[locale]}<span class="plus" aria-hidden="true"></span></summary>
            <p class="muted">{q.answer[locale]}</p>
          </details>
        ))}
        <p class="small muted by">{ui.writtenBy} <a class="link" href={href(locale, "/about")}>{ui.background}</a></p>
        <p class="others">
          {others.map((o) => <a class="chev" href={href(locale, `/expertises/${o.slug}`)}>{CLUSTER_LABEL[o.slug][locale]}</a>)}
        </p>
      </div>
    </div>
  </section>
</Base>
<style>
  .sections { display: grid; gap: 0.75rem; }
  .block { display: grid; gap: 0.9rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .num { font-size: var(--t-sm); font-weight: 600; color: var(--fg-2); }
  .body { max-width: 68ch; color: var(--fg-2); }
  .grid { display: grid; gap: 1rem; margin-top: clamp(2rem, 5vw, 3rem); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .block { grid-template-columns: 3rem 1fr 1.6fr; gap: 2rem; } }
  .faq { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 1.4fr; } }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.4rem; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .plus { flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%; border: 1px solid var(--line-2); position: relative; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 30%; top: 50%; width: 40%; height: 1.5px; background: currentColor; transition: rotate 0.35s var(--ease-out); }
  .plus::after { rotate: 90deg; }
  details[open] .plus::after { rotate: 0deg; }
  details p { padding-bottom: 1.5rem; max-width: 62ch; }
  details::details-content { block-size: 0; overflow: hidden; transition: block-size 0.45s var(--ease-out), content-visibility 0.45s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  .by { margin-top: 2rem; }
  .others { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 0.5rem; }
</style>
