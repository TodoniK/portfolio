---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import BgVideo from "../components/BgVideo.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHead from "../components/SectionHead.astro";
import { UI, SITE, href, projects, CLUSTERS, CLUSTER_LABEL, type Locale, type ExpertiseSlug } from "../data/site";
import { EXPERTISES } from "../data/expertises";
import { breadcrumb, faqSchema, PERSON_ID } from "../data/schema";

interface Props { locale: Locale; slug: ExpertiseSlug }
const { locale, slug } = Astro.props;
const ui = UI[locale];
const e = EXPERTISES[slug];
const cluster = CLUSTERS.find((c) => c.slug === slug)!;
const related = projects(locale).filter((p) => (e.projects as readonly string[]).includes(p.id));
const others = CLUSTERS.filter((c) => c.slug !== slug);
const url = new URL(href(locale, `/expertises/${slug}`), SITE.url).href;
const schema = [
  breadcrumb(locale, [[e.title[locale], href(locale, `/expertises/${slug}`)]]),
  { "@type": "WebPage", "@id": `${url}#webpage`, url, name: e.title[locale], description: e.summary[locale], inLanguage: locale, author: { "@id": PERSON_ID }, about: e.title[locale] },
  faqSchema(locale, slug),
];
---
<Base locale={locale} title={e.title[locale]} description={e.summary[locale]} schema={schema}>
  <PageHero locale={locale} kicker={`Jules Royet · ${ui.location} · ${cluster.code}`} title={e.title[locale]} lead={e.summary[locale]} crumbs={[[e.title[locale], href(locale, `/expertises/${slug}`)]]}>
    <div class="media" slot="media" aria-hidden="true"><BgVideo ids={[cluster.video]} locale={locale} controls={false} /></div>
  </PageHero>

  <article class="section">
    <div class="wrap sections">
      {e.sections.map((s, i) => (
        <section class="block reveal">
          <p class="mono num">{String(i + 1).padStart(2, "0")}</p>
          <h2 class="h3">{s[locale]}</h2>
          <p class="body">{s.body[locale]}</p>
        </section>
      ))}
    </div>
  </article>

  <section class="section on-ink grain" aria-labelledby="related">
    <div class="wrap">
      <SectionHead num="04" label={ui.relatedWork} />
      <h2 id="related" class="h2" data-split>{ui.relatedWork}</h2>
      <ol class="grid" role="list">
        {related.map((p) => <li class="reveal"><ProjectCard project={p} locale={locale} /></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap faq">
      <div>
        <SectionHead num="05" label={ui.faq} />
        <h2 id="faq" class="h2">{ui.faq}</h2>
      </div>
      <div class="qa">
        {e.questions.map((q) => (
          <details>
            <summary class="h3">{q[locale]}<span class="plus" aria-hidden="true"></span></summary>
            <p class="muted">{q.answer[locale]}</p>
          </details>
        ))}
        <p class="mono muted by">{ui.writtenBy} <a class="inline-link" href={href(locale, "/about")}>{ui.background}</a></p>
        <p class="mono others">
          {others.map((o) => <a class="inline-link" href={href(locale, `/expertises/${o.slug}`)}>{CLUSTER_LABEL[o.slug][locale]}</a>)}
        </p>
      </div>
    </div>
  </section>
</Base>
<style>
  .media { position: absolute; inset: 0; z-index: -1; opacity: 0.45; }
  .media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--ink) 25%, transparent 100%); }
  .sections { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .block { display: grid; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .num { color: var(--accent); }
  .body { max-width: 68ch; }
  .grid { display: grid; gap: 3rem 2rem; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .block { grid-template-columns: 4rem 1fr 1.6fr; gap: 2rem; } }
  .faq { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 1.4fr; } }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .plus { flex: none; width: 1rem; height: 1rem; position: relative; margin-top: 0.3em; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 0; top: 50%; width: 100%; height: 1.5px; background: currentColor; transition: rotate 0.3s var(--ease-out); }
  .plus::after { rotate: 90deg; }
  details[open] .plus::after { rotate: 0deg; }
  details p { padding-bottom: 1.5rem; max-width: 62ch; }
  .by { margin-top: 2rem; text-transform: none; letter-spacing: 0; }
  .others { display: flex; gap: 1.5rem; margin-top: 1rem; }
</style>
