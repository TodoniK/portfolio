---
import "../styles/global.css";
import { createHash } from "node:crypto";
import inter from "../assets/fonts/inter.woff2?url";
import { getImage } from "astro:assets";
import memojiSrc from "../assets/portraits/memoji.png";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, UI, alternatePath, type Locale } from "../data/site";
import { personGraph } from "../data/schema";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Extra JSON-LD nodes for this page, merged into the site graph. */
  schema?: Record<string, unknown>[];
  og?: string;
  noindex?: boolean;
}
const { locale, title, description, schema = [], og, noindex = false} = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/(.)\/$/, "$1") || "/";
const canonical = new URL(path, SITE.url).href;
const fr = new URL(alternatePath(path, "fr"), SITE.url).href;
const en = new URL(alternatePath(path, "en"), SITE.url).href;
const ogSlug = og ?? (path === "/" ? "home" : path.slice(1).replaceAll("/", "-"));
const ogImage = new URL(`/og/${ogSlug}.jpg`, SITE.url).href;
const fullTitle = title.includes("Jules Royet") ? title : `${title} | Jules Royet`;
const ui = UI[locale];
// Runs before first paint: decides splash/arrival state. Hashed explicitly for the CSP.
const BOOT = `(function(){var d=document.documentElement;d.classList.remove("no-js");if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;try{if(!sessionStorage.getItem("jr-boot")){d.classList.add("is-splash");sessionStorage.setItem("jr-boot","1")}else if(sessionStorage.getItem("jr-nav")){d.classList.add("is-arriving")}sessionStorage.removeItem("jr-nav")}catch(e){}})();`;
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(BOOT).digest("base64")}`);
const memoji = await getImage({ src: memojiSrc, format: "avif", width: 192, quality: 70 });
const hello = locale === "fr" ? ["Bonjour", "Hello", "Hola"] : ["Hello", "Bonjour", "Hola"];
const graph = { "@context": "https://schema.org", "@graph": [...personGraph(locale), ...schema] };
---

<!doctype html>
<html lang={locale} class="no-js" data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={fr} />
          <link rel="alternate" hreflang="en" href={en} />
          <link rel="alternate" hreflang="x-default" href={fr} />
        </>
      )
    }
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content="Jules Royet" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content={path.includes("/projects/") ? "article" : "website"} />
    <meta property="og:site_name" content="Jules Royet" />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "fr" ? "en_US" : "fr_FR"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={SITE.twitter} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <slot name="head" />
    <script is:inline set:html={BOOT} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Cloudflare Web Analytics : sans cookie (site julesroyet.dev, injection automatique désactivée) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bde96f20bd284ad6b30bbe7ee4ce11ed"}'></script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <div class="splash" aria-hidden="true">
      <div class="inner">
        <img src={memoji.src} alt="" width="92" height="92" />
        <p class="words">{hello.map((w) => <span>{w}</span>)}</p>
      </div>
    </div>
    <div class="curtain" aria-hidden="true">
      <div class="inner"><img src={memoji.src} alt="" width="56" height="56" /><span class="route" data-curtain-route>{ui.loading}</span><span class="bar"></span></div>
    </div>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed; left: 1rem; top: 0.5rem; z-index: 200; padding: 0.6rem 1rem; border-radius: var(--pill);
    background: var(--fg); color: var(--bg); font-size: var(--t-sm); transform: translateY(-200%); transition: transform 0.2s;
  }
  .skip:focus { transform: none; }
  main:focus { outline: none; }
</style>
