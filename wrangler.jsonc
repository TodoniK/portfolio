{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jules-portfolio",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
